{
  "name": "duskmere",
  "version": "0.2.0",
  "private": true,
  "description": "DUSKMERE - offline voxel medieval adventure for iPad (PWA)",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "npm run icons && vite --host",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vite-plugin-pwa": "0.21.2",
    "workbox-window": "7.4.1"
  }
}
